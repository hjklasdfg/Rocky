# --- MiniMax LLM + Embeddings ---
# Token Plan key (sk-cp-...) for cheap chat under subscription quota
MINIMAX_API_KEY=your-minimax-api-key-here
# Optional: separate pay-as-you-go key (sk-api-...) for T2A voice synthesis.
# Token Plans typically don't include speech models — set this if your plan
# doesn't cover speech-02-* and you want voice output. Falls back to
# MINIMAX_API_KEY when unset (which works only if your plan covers T2A).
# MINIMAX_T2A_API_KEY=sk-api-...
# Optional overrides (defaults shown)
# International platform (default): https://api.minimax.io/v1   <- note .io, not .com
# China platform:                   https://api.minimax.chat/v1
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M2.7
# MINIMAX_EMBED_MODEL=embo-02
# MINIMAX_T2A_MODEL=speech-02-hd
# Built-in presets: English_expressive_narrator, Calm_Woman, male-qn-qingse, female-shaonv
# Or paste a cloned voice_id once you've created one
# MINIMAX_VOICE_ID=English_expressive_narrator
# AUDIO_CACHE_DIR=./audio_cache

# --- Brave Search (web search tool) ---
# Free tier: 2,000 queries/month. Get one at https://brave.com/search/api/
BRAVE_API_KEY=your-brave-api-key-here

# --- Multi-user OAuth (required for /login flow) ---
GOOGLE_CLIENT_ID=your-web-client-id
GOOGLE_CLIENT_SECRET=your-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Database ---
DATABASE_URL=postgresql://rocky:rocky@localhost:5432/rocky

# Token encryption key (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=your-fernet-key-here

# --- RAG ---
# Local Chroma persistent storage path (default: ./chroma_db)
# CHROMA_PATH=./chroma_db

# --- Prompt versioning ---
# Override to swap the active prompt set without code changes
# PROMPT_VERSION=v1
