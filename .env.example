# --- MiniMax LLM + Embeddings ---
# Token Plan key (sk-cp-...) for cheap chat under subscription quota
MINIMAX_API_KEY=your-minimax-api-key-here
# Optional: separate pay-as-you-go key (sk-api-...) for T2A voice synthesis.
# Token Plans typically don't include speech models — set this if your plan
# doesn't cover speech-02-* and you want voice output. Falls back to
# MINIMAX_API_KEY when unset (which works only if your plan covers T2A).
# MINIMAX_T2A_API_KEY=sk-api-...
# Optional: separate pay-as-you-go key for embeddings. Token Plans usually
# have very low RPM caps on embo-02 which makes bulk RAG backfill fail with
# 'rate limit exceeded(RPM)'. If unset, falls back to MINIMAX_T2A_API_KEY
# (the same pay-as-you-go key works for both), then MINIMAX_API_KEY.
# MINIMAX_EMBED_API_KEY=sk-api-...
# Optional overrides (defaults shown)
# International platform (default): https://api.minimax.io/v1   <- note .io, not .com
# China platform:                   https://api.minimax.chat/v1
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M2.7
# MINIMAX_EMBED_MODEL=embo-02
# MINIMAX_T2A_MODEL=speech-2.8-hd  # Latest HD model. Older variants: speech-02-hd, speech-2.6-hd, speech-2.5-hd. voice_id is portable across them.
# Built-in presets: English_expressive_narrator, Calm_Woman, male-qn-qingse, female-shaonv
# Or paste a cloned voice_id once you've created one
# MINIMAX_VOICE_ID=English_expressive_narrator
# AUDIO_CACHE_DIR=./audio_cache

# --- Brave Search (web search tool) ---
# Free tier: 2,000 queries/month. Get one at https://brave.com/search/api/
BRAVE_API_KEY=your-brave-api-key-here

# --- Multi-user OAuth (required for /login flow) ---
GOOGLE_CLIENT_ID=your-web-client-id
GOOGLE_CLIENT_SECRET=your-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Database ---
DATABASE_URL=postgresql://rocky:rocky@localhost:5432/rocky

# Token encryption key (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=your-fernet-key-here

# --- Multi-tenant access control ---
# Comma-separated list of emails that get FREE access — they may use the
# server's env-var keys without configuring their own. Everyone else (any
# new user signing up via /login) is required to BYOK at /settings before
# /api/chat will respond. Add yourself + anyone you'd happily comp.
# Empty / unset means "no exemptions, everyone must BYOK".
# OPERATOR_EMAILS=you@example.com,family@example.com

# --- RAG embedding provider ---
# Which backend produces vectors for the email knowledge index.
#   local    — sentence-transformers, runs on-device. No API key, no quota,
#              no network. Default. Uses MPS on Apple Silicon, else CPU.
#   minimax  — MiniMax embo-02 via HTTP. International platform doesn't
#              currently expose this publicly; use only with China-platform
#              accounts or whitelist access.
#   openai   — OpenAI text-embedding-3-small. Requires OPENAI_API_KEY.
# EMBEDDING_PROVIDER=local
# Override the model per provider (defaults shown):
# LOCAL_EMBED_MODEL=all-MiniLM-L6-v2          # 384-dim, ~22MB
# LOCAL_EMBED_MODEL=all-mpnet-base-v2         # 768-dim, ~110MB, better quality
# OPENAI_EMBED_MODEL=text-embedding-3-small   # 1536-dim
# MINIMAX_EMBED_MODEL=embo-02                 # 1024-dim

# --- Prompt versioning ---
# Override to swap the active prompt set without code changes
# PROMPT_VERSION=v1
